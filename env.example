# Rename to .env.example (this workspace's tool permissions block writing .env* files).
# Add these keys to the WORKSPACE ROOT .env (/home/hadisaputra/boomi-projects/.env, gitignored).
# Never commit real values.

# --- Local PostgreSQL (optional, offline dev only: docker compose --env-file .env -f payment-intelligence/db/docker-compose.yml up -d) ---
POSTGRES_USER=pi_app
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-18
POSTGRES_PORT=5432

# --- Neon serverless PostgreSQL (the database Boomi uses; SQL over HTTPS via the REST connector) ---
# Only needed to (re)create the Boomi connection with tools/create-neon-components.sh;
# the deployed connection already holds its secret header, encrypted.
# NEON_HOST=ep-xxxxxxxx.region.aws.neon.tech
# NEON_CONNECTION_STRING=postgresql://user:password@ep-xxxxxxxx.region.aws.neon.tech/dbname?sslmode=require

# --- Twilio WhatsApp (already in the root .env; the auth token must be the rotated one) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=rotated-token
TWILIO_WHATSAPP_FROM=whatsapp:+1xxxxxxxxxx
# Optional: send an approved WhatsApp Content Template instead of the free-form alert Body (leave unset for Body).
# Content Templates need a paid (non-Trial) Twilio account.
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_TO=whatsapp:+62xxxxxxxxxx

# --- Local frontend proxy (it injects Boomi Basic auth server side; the browser never sees it) ---
PROXY_PORT=8080
